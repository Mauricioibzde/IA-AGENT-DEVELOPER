# Example environment configuration for IA Agent Developer
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_PLANNER_MODEL=qwen2.5-coder:7b
OLLAMA_CODER_MODEL=qwen2.5-coder:7b
OLLAMA_REFLECTION_MODEL=qwen2.5-coder:7b
AGENT_MAX_STEPS=12
AGENT_MAX_TASK_ATTEMPTS=3
AGENT_MAX_MODEL_CALLS=40
AGENT_MAX_COMMANDS=30
AGENT_COMMAND_TIMEOUT=60
AGENT_READ_FILE_MAX_BYTES=200000

# Deploy (Forge Platform — botão Deploy)
# VERCEL_TOKEN=your_token_from_vercel.com/account/tokens
# VERCEL_PROD=false
